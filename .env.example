########### pg、Redis ###########
# PostgreSQL 数据库密码，必须替换为强密码。
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# Redis 访问密码，必须替换为强密码。
REDIS_PASSWORD=replace_with_strong_redis_password


########### frontend ###########
# 前端在宿主机上的监听地址，0.0.0.0 表示允许公网访问。
FRONTEND_BIND_ADDRESS=0.0.0.0

# 前端映射到宿主机的 HTTP 端口。
FRONTEND_PORT=80


########### backend ###########
# OpenAI 兼容对话服务的基础地址。
CHAT_BASE_URL=https://your-chat-provider.example.com/v1

# OpenAI 兼容对话服务的 API Key。
CHAT_API_KEY=replace_with_chat_api_key

# 后端默认使用并向前端公开的对话模型编码。
CHAT_MODEL=your-chat-model

# OpenAI 兼容嵌入服务的基础地址。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI 兼容嵌入服务的 API Key。
EMBEDDING_API_KEY=replace_with_embedding_api_key

# 文档向量化使用的嵌入模型编码。
EMBEDDING_MODEL=BAAI/bge-m3

# 嵌入模型输出的向量维度，必须与模型和数据库向量列一致。
EMBEDDING_DIMENSION=1024

# 保存该模型向量的表名，必须是 Flyway 已创建的表。
EMBEDDING_VECTOR_TABLE=vector_store_siliconflow_bge_m3
