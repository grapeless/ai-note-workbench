########### pg、Redis ###########
# PostgreSQL 数据库密码，必须替换为强密码。
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# Redis 访问密码，必须替换为强密码。
REDIS_PASSWORD=replace_with_strong_redis_password


########### frontend ###########
# 前端在宿主机上的监听地址，0.0.0.0 表示允许公网访问。
FRONTEND_BIND_ADDRESS=0.0.0.0

# 已备案且解析到服务器公网 IP 的域名；Caddy 会自动申请并续期 HTTPS 证书。
APP_DOMAIN=note.example.com

# 整站共享的 Basic Auth 用户名。
BASIC_AUTH_USER=demo

# 使用 `docker run --rm -it caddy:2-alpine caddy hash-password` 生成。
# 必须使用单引号，避免 Compose 把 bcrypt 哈希中的 `$` 当作变量展开。
BASIC_AUTH_PASSWORD_HASH='replace_with_caddy_bcrypt_hash'


########### backend ###########
# DeepSeek 对话服务 API Key。
CHAT_DEEPSEEK_API_KEY=replace_with_deepseek_api_key

# DashScope 对话服务 API Key。
CHAT_DASHSCOPE_API_KEY=replace_with_dashscope_chat_api_key

# SiliconFlow 嵌入服务 API Key。
EMBEDDING_SILICONFLOW_API_KEY=replace_with_siliconflow_api_key

# DashScope 嵌入服务 API Key。
EMBEDDING_DASHSCOPE_API_KEY=replace_with_dashscope_embedding_api_key
