<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lim.noteworkbench.mapper.ChatConversationMapper">
    <resultMap id="ChatConversationResultMap"
               type="com.lim.noteworkbench.model.entity.ChatConversation">
        <id property="id" column="id" jdbcType="OTHER"/>
        <result property="collectionId" column="collection_id" jdbcType="BIGINT"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.lim.noteworkbench.model.entity.ChatConversation">
        INSERT INTO chat_conversation (id,
        collection_id,
        title)
        VALUES (#{id},
        #{collectionId},
        #{title})
    </insert>

    <select id="findById" resultMap="ChatConversationResultMap">
        SELECT id,
        collection_id,
        title,
        create_time,
        update_time
        FROM chat_conversation
        WHERE id = #{id}
    </select>

    <select id="findByCollectionId" resultMap="ChatConversationResultMap">
        SELECT id,
        collection_id,
        title,
        create_time,
        update_time
        FROM chat_conversation
        WHERE collection_id = #{collectionId}
        ORDER BY update_time DESC
    </select>

    <update id="updateTime">
        UPDATE chat_conversation
        SET update_time = now()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE
        FROM chat_conversation
        WHERE id = #{id}
    </delete>

    <delete id="deleteByCollectionId">
        DELETE
        FROM chat_conversation
        WHERE collection_id = #{collectionId}
    </delete>
</mapper>
